# Bot's own WhatsApp number, digits only with country code (used once for the pairing code)
BOT_PHONE=5511900000000
# Groups this bot serves, comma-separated: a jid (the '@g.us' suffix is optional) or a
# chat.whatsapp.com invite link. A link is resolved at boot — no need to join first — and
# the jid it resolves to is remembered, so a later revoked or failing link only logs a
# warning and the group keeps working off the cached jid. Removing the link from this
# variable is still what turns a group off. Anywhere else the bot is completely inert:
# it reads nothing, answers nothing, and never leaves.
# Being removed from a group also turns it off immediately, on the spot, even if this
# variable still names it — the only way back is this variable still naming the group
# (jid or link) at a later start.
# Optional: leave empty and the bot boots serving nobody. Add it to a WhatsApp group,
# then read the jid off the log line that fires at that moment, and put it here.
GROUP_INVITE_LINKS=
# Language the bot writes in: pt-BR, en or es (it understands all three either way)
BOT_LANG=pt-BR
# Currency for amounts and totals, ISO 4217 (BRL, USD, EUR, MXN, ...)
BOT_CURRENCY=BRL
# 9router / any OpenAI-compatible endpoint
LLM_BASE_URL=http://192.168.2.4:20128/v1
LLM_API_KEY=
LLM_TEXT_MODEL=cx/gpt-5.4-mini
LLM_VISION_MODEL=cx/gpt-5.5
# Optional
TZ=America/Sao_Paulo
LOG_LEVEL=info
