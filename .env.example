# Bot's own WhatsApp number, digits only with country code (used once for the pairing code)
BOT_PHONE=5511900000000
# Numbers allowed to use the bot, digits with country code, comma-separated.
# The bot only stays in groups where at least one of them is a member.
OWNER_PHONES=5511999999999,5511888888888
# Language the bot writes in: pt-BR, en or es (it understands all three either way)
BOT_LANG=pt-BR
# Currency for amounts and totals, ISO 4217 (BRL, USD, EUR, MXN, ...)
BOT_CURRENCY=BRL
# Only for upgrading from the single-group version: the old group's JID, used once to migrate data/state.json.
GROUP_JID=
# 9router / any OpenAI-compatible endpoint
LLM_BASE_URL=http://192.168.2.4:20128/v1
LLM_API_KEY=
LLM_TEXT_MODEL=cx/gpt-5.4-mini
LLM_VISION_MODEL=cx/gpt-5.5
# Optional
TZ=America/Sao_Paulo
LOG_LEVEL=info
