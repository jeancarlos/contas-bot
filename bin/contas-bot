#!/bin/sh
set -eu
REPO=jeancarlos/contas-bot
API=${CONTAS_BOT_API:-https://api.github.com/repos/$REPO/releases/latest}
DIR=$(dirname "$(readlink -f "$0")")
cd "$DIR"
lang=$(sed -n 's/^BOT_LANG=//p' .env 2>/dev/null | head -n 1)

say() { case "$lang" in en) printf '%s\n' "$2" ;; es) printf '%s\n' "$3" ;; *) printf '%s\n' "$1" ;; esac; }
image() { sed -n 's/^ *image: *//p' docker-compose.yml | head -n 1; }
installed() { image | sed -n 's/^[^ ]*:\([0-9][^ ]*\)$/\1/p'; }
latest() { curl -fsSL "$API" | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1; }
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$2" ]; }
setup() { docker run --rm -it --user "$(id -u):$(id -g)" -v "$DIR:/setup" "$(image)" node src/setup.ts <"${CONTAS_BOT_TTY:-/dev/tty}"; }
usage() { say "uso: contas-bot update | status | logs | pair | restart" "usage: contas-bot update | status | logs | pair | restart" "uso: contas-bot update | status | logs | pair | restart"; }

case "${1:-help}" in
  update)
    cur=$(installed)
    case "$cur" in ''|*[!0-9.]*) say "❌ não consegui consultar a versão atual" "❌ couldn't check the current version" "❌ no pude consultar la versión actual" >&2; exit 1 ;; esac
    new=$(latest 2>/dev/null || true)
    case "$new" in ''|*[!0-9.]*) say "❌ não consegui consultar a versão mais nova (sem internet?)" "❌ couldn't check for the newest version (offline?)" "❌ no pude consultar la versión más nueva (¿sin internet?)" >&2; exit 1 ;; esac
    if ! newer "$cur" "$new"; then
      say "✅ já está na v$cur" "✅ already on v$cur" "✅ ya está en v$cur"
      exit 0
    fi
    say "🆕 v$cur → v$new" "🆕 v$cur → v$new" "🆕 v$cur → v$new"
    printf '%s ' "$(say 'Atualizar agora? [s/N]' 'Update now? [y/N]' '¿Actualizar ahora? [s/N]')"
    ans=$( { head -n 1; } 2>/dev/null <"${CONTAS_BOT_TTY:-/dev/tty}" || true)
    if [ -z "$ans" ]; then
      say "sem terminal para confirmar: rode contas-bot update num terminal" "no terminal to confirm: run contas-bot update in a terminal" "sin terminal para confirmar: ejecuta contas-bot update en un terminal"
      exit 0
    fi
    case "$ans" in s|S|y|Y|sim|yes|si|sí) ;; *) exit 0 ;; esac
    tmp=$(mktemp) || exit 1
    trap 'rm -f "$tmp"' EXIT
    curl -fsSL -o "$tmp" "https://github.com/$REPO/releases/download/v$new/install.sh" || exit 1
    CONTAS_BOT_DIR="$DIR" sh "$tmp"; exit $?
    ;;
  status)
    state=$(docker inspect -f '{{.State.Status}}' contas-bot 2>/dev/null || echo "—")
    if grep -q '"me"' auth/creds.json 2>/dev/null; then pairedv=✅; else pairedv=❌; fi
    groups=$(grep -o '"[0-9-]*@g\.us"' data/state.json 2>/dev/null | sort -u | wc -l | tr -d ' ')
    say "🤖 contas-bot v$(installed) · container: $state · pareado: $pairedv · grupos: $groups" \
        "🤖 contas-bot v$(installed) · container: $state · paired: $pairedv · groups: $groups" \
        "🤖 contas-bot v$(installed) · contenedor: $state · vinculado: $pairedv · grupos: $groups"
    ;;
  logs) exec docker logs -f --tail 100 contas-bot ;;
  pair)
    setup_status=0
    setup || setup_status=$?
    docker compose up -d
    exit $setup_status
    ;;
  restart) docker compose restart ;;
  help|"-h"|"--help") usage; exit 0 ;;
  *)
    usage >&2
    exit 2
    ;;
esac
