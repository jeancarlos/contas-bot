{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["src/**", "test/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error" },
      "suspicious": { "noConsole": "error", "noExplicitAny": "error" },
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } }
      },
      "nursery": { "noFloatingPromises": "error", "useExhaustiveSwitchCases": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pino": "core is pure: logging belongs to the shell",
                  "@whiskeysockets/baileys": "core is pure: WhatsApp belongs to the adapters"
                },
                "patterns": [
                  { "group": ["node:*"], "message": "core is pure: no Node I/O" },
                  { "group": ["../*", "../../*"], "message": "core may only import core" }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "core is pure: time comes in on the input",
                  "setTimeout": "core is pure: no timers",
                  "setInterval": "core is pure: no timers",
                  "process": "core is pure: configuration comes in on the ctx"
                }
              }
            }
          }
        }
      }
    }
  ]
}
