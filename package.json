{
  "name": "contas-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/shell/index.ts",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.strict.json",
    "test": "TZ=America/Sao_Paulo node --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "sh scripts/install-hooks.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.14",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.0"
  }
}
