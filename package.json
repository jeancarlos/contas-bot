{
  "name": "contas-bot",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/shell/index.ts",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit -p .",
    "test": "TZ=America/Sao_Paulo node --test \"test/**/*.test.ts\"",
    "coverage": "TZ=America/Sao_Paulo node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-branches=93 --test-coverage-functions=93 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.ts\"",
    "changelog": "node scripts/changelog.ts --md CHANGELOG.md",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "sh scripts/install-hooks.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
